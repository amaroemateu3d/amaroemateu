# ==========================================================
# Variáveis de Ambiente - AM3D Soluções (amaroemateu)
# Copie este arquivo para .env.local e preencha com os valores reais
# ==========================================================

# 1. Supabase (Settings -> API no painel do Supabase)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_publica_aqui

# 2. Mercado Livre API Oficial (App próprio criado na conta do ML em developers.mercadolivre.com.br)
# Obs: você também pode preencher/editar essas credenciais direto na tela Estoque -> Anúncios Mercado Livre -> App ML
VITE_ML_CLIENT_ID=1234567890123456
VITE_ML_CLIENT_SECRET=seu_client_secret_do_mercado_livre
VITE_ML_REDIRECT_URI=https://amaroemateu.vercel.app/estoque
